{
  "images": {
    "sizes": [256, 384, 640, 1080],
    "formats": ["image/avif", "image/webp"],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "cdn.paris.fr",
        "pathname": "/qfapv4/**"
      }
    ]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/event.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/stats/script.js", "destination": "https://cloud.umami.is/script.js" },
    { "source": "/sitemap.xml", "destination": "https://api.wandercity.fr/sitemap.xml" },
    { "source": "/event/:categorie/:slug/:id", "destination": "/api/event?categorie=:categorie&slug=:slug&id=:id" },
    { "source": "/((?!_vercel/|api/).*)", "destination": "/" }
  ]
}
